<?xml version="1.0"?>
<!-- rules-mcp — registro regole Financial Portfolio.
     Copia sanitizzata: i segreti sono CAMBIAMI e il preflight li rifiuta.
     Il processo gira come ROOT di proposito: il .db resta 644 e dalla share
     si legge soltanto. NON aggiungere VAULT_UID/VAULT_GID.
     Va in /boot/config/plugins/dockerMan/templates-user/my-rules-mcp.xml -->
<Container version="2">
  <Name>rules-mcp</Name>
  <Repository>rules-mcp</Repository>
  <Registry/>
  <Network>bridge</Network>
  <MyIP/>
  <MyMAC/>
  <Shell>sh</Shell>
  <Privileged>false</Privileged>
  <Support/>
  <Project/>
  <ReadMe/>
  <Overview/>
  <Category/>
  <WebUI>http://[IP]:[PORT:3001]/</WebUI>
  <TemplateURL/>
  <Icon/>
  <ExtraParams>--restart=unless-stopped</ExtraParams>
  <PostArgs>entrypoint.sh</PostArgs>
  <CPUset/>
  <DonateText/>
  <DonateLink/>
  <Requires/>
  <Config Name="Database" Target="/db" Default="" Mode="rw" Description="dataset Claude/Database" Type="Path" Display="always" Required="true" Mask="false">/mnt/cache/Claude/Database/</Config>
  <Config Name="App Data" Target="/data" Default="" Mode="rw" Description="" Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/rules-mcp/data</Config>
  <Config Name="Tailscale State" Target="/var/lib/tailscale" Default="" Mode="rw" Description="" Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/rules-mcp/ts-state</Config>
  <Config Name="DB Path" Target="DB_PATH" Default="" Mode="" Description="database unico, tutti i progetti" Type="Variable" Display="always" Required="true" Mask="false">/db/regole.db</Config>
  <Config Name="Backup Dir" Target="BACKUP_DIR" Default="" Mode="" Description="copie VACUUM INTO" Type="Variable" Display="always" Required="false" Mask="false">/db/backup</Config>
  <Config Name="Admin Access Code" Target="ADMIN_ACCESS_CODE" Default="" Mode="" Description="codice di scrittura, min 12 caratteri" Type="Variable" Display="always" Required="true" Mask="true">CAMBIAMI</Config>
  <Config Name="Public URL" Target="BASE_URL" Default="" Mode="" Description="" Type="Variable" Display="always" Required="true" Mask="false">https://svc-a2.marlin-kelvin.ts.net</Config>
  <Config Name="GitHub Client ID" Target="GITHUB_CLIENT_ID" Default="" Mode="" Description="OAuth App NUOVA per svc-a2" Type="Variable" Display="always" Required="true" Mask="false">CAMBIAMI</Config>
  <Config Name="GitHub Client Secret" Target="GITHUB_CLIENT_SECRET" Default="" Mode="" Description="" Type="Variable" Display="always" Required="true" Mask="true">CAMBIAMI</Config>
  <Config Name="Allowed Users" Target="ALLOWED_GITHUB_LOGIN" Default="" Mode="" Description="" Type="Variable" Display="always" Required="true" Mask="false">alcor6502</Config>
  <Config Name="Signing Key" Target="JWT_SIGNING_KEY" Default="" Mode="" Description="openssl rand -hex 32, poi MAI piu' cambiata" Type="Variable" Display="always" Required="true" Mask="true">CAMBIAMI</Config>
  <Config Name="Port" Target="PORT" Default="" Mode="" Description="" Type="Variable" Display="always" Required="true" Mask="false">3001</Config>
  <Config Name="Anthropic IP Filter" Target="ANTHROPIC_CIDR" Default="" Mode="" Description="" Type="Variable" Display="always" Required="false" Mask="false">160.79.104.0/21</Config>
  <TailscaleEnabled>true</TailscaleEnabled>
  <TailscaleIsExitNode>false</TailscaleIsExitNode>
  <TailscaleHostname>svc-a2</TailscaleHostname>
  <TailscaleExitNodeIP/>
  <TailscaleSSH>false</TailscaleSSH>
  <TailscaleUserspaceNetworking>false</TailscaleUserspaceNetworking>
  <TailscaleLANAccess>false</TailscaleLANAccess>
  <TailscaleServe>funnel</TailscaleServe>
  <TailscaleWebUI>https://[hostname][magicdns]/</TailscaleWebUI>
  <TailscaleServePort>3001</TailscaleServePort>
  <TailscaleServeTarget/>
  <TailscaleServeLocalPath/>
  <TailscaleServeProtocol/>
  <TailscaleServeProtocolPort/>
  <TailscaleServePath/>
  <TailscaleDParams/>
  <TailscaleParams/>
  <TailscaleRoutes/>
  <TailscaleAcceptRoutes>false</TailscaleAcceptRoutes>
  <TailscaleStateDir>/var/lib/tailscale</TailscaleStateDir>
</Container>
